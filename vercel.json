{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 13 * * *"
    }
  ]
}
